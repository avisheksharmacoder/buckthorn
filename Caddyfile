# Caddyfile
{
	servers {
		protocols h1 h2 h3
		timeouts {
			read_body   10s
			read_header 5s
			write       15s
			idle        30s
		}
	}
}

api.example.com, localhost:8080 {
	# Enforce 1MB payload cap at the edge before forwarding to Buckthorn
	request_body {
		max_size 1MB
	}

	reverse_proxy buckthorn:8000 {
		# Overwrite X-Forwarded-For with actual remote IP to protect Buckthorn's C rate limiter
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Keep warm HTTP/1.1 sockets open to Buckthorn's libuv workers (<= 15s idle timer)
		transport http {
			versions 1.1
			keepalive 12s
			keepalive_idle_conns 256
			keepalive_idle_conns_per_host 256
		}
	}
}
