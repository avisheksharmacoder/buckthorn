# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C compilation and Cython shared libraries
*.o
*.obj
*.so
*.dylib
*.pyd
*.a

# Cython generated C/C++ files and annotations (preserves c_src/ and c_vendor/)
buckthorn/_core.c
buckthorn/_core.cpp
buckthorn/*.html

# Distribution / packaging
build/
dist/
dist_*/
.compiled_bench/
eggs/
.eggs/
*.egg-info/
*.egg
*.whl

# Virtual environments & secrets
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example

# Testing, type checking, and linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.cache

# Logs and runtime artifacts
*.log
buckthorn.log

# IDE & Editor files
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
